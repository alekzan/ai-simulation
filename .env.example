# ---------------------------------------------
# AI-Driven Simulation Engine - Demo Environment
# Copy this file to .env and adjust only if needed.
# Never put real secrets in .env.example.
# ---------------------------------------------

# Optional backend fallback API keys.
# In normal UI flow, users provide key in-app and it is sent via X-Gemini-Api-Key.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Runtime mode: development | production
APP_ENV=development

# SQLite database path.
SIM_DB_PATH=backend/data/app.db

# In development, use fixed title ideas/covers to save API usage.
TITLE_DEV_FIXED_OPTIONS=true

# Thinking-level controls for Gemini calls.
GEMINI_THINKING_LEVEL=
GEMINI_FORCE_DEV_THINKING_LEVEL=true

# Disk cleanup windows for generated media.
# 0 means "keep" (no TTL cleanup).
MEDIA_IMAGE_RETENTION_SECONDS=0
MEDIA_AUDIO_RETENTION_SECONDS=900
MEDIA_VIDEO_RETENTION_SECONDS=900

# Image optimization settings for generated scene images.
EPHEMERAL_IMAGE_FORMAT=WEBP
EPHEMERAL_IMAGE_QUALITY=60
EPHEMERAL_IMAGE_MAX_DIM=1024

# Optional local debug tokens for forcing endings/game-over in development.
ENDING_DEBUG_TOKEN=3nD1n6N0W
GAMEOVER_DEBUG_TOKEN=G4m30v3rN0W
